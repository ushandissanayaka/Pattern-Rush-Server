# Local development only. On Bloxity Legion these are injected for you.
PORT=3000
# Comma-separated client origins allowed to connect, or * for any.
CLIENT_ORIGIN=*
# Players one process holds before refusing new ones (Legion: the deploy's seatCap).
SEAT_CAP=50
# Gems webhook grants. Unset locally -> kept in memory. Legion injects the managed Mongo URI.
MONGODB_URI=
# Must match the webhook secret configured for the game on Boxity (header x-legion-webhook-secret).
LEGION_WEBHOOK_SECRET=
# Only to point token verification at a staging API; defaults to https://api.bloxity.io.
BLOXITY_API_URL=
